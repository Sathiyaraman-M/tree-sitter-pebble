{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pebble",
      "camelcase": "Pebble",
      "title": "Pebble",
      "scope": "source.pebble",
      "file-types": [
        "pebble"
      ],
      "injection-regex": "^pebble$",
      "class-name": "TreeSitterPebble"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Pebble is a simple made-up language for writing plans",
    "authors": [
      {
        "name": "bruce",
        "email": "bruce@sathiyaraman-m.com",
        "url": "https://www.sathiyaraman-m.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-pebble",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}